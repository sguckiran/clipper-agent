# ---- LLM / Transcription ----
AI_PROVIDER=auto
GPT_API_KEY=
OPENAI_API_KEY=
# auto prefers OpenAI when GPT_API_KEY/OPENAI_API_KEY is present, otherwise Groq.
# OpenAI powers transcription, clip research, coherence/layout scoring and captions.
GROQ_API_KEY=

# Anthropic — reserved for future modules; not required by the current pipeline.
ANTHROPIC_API_KEY=

# Model overrides (optional; sensible defaults applied in config).
# OpenAI defaults: whisper-1 for timestamped speech-to-text; gpt-5.6-luna for
# coherent clip scoring/captions. Groq fallback defaults to whisper-large-v3-turbo
# and llama-3.3-70b-versatile.
CLIPPER_TRANSCRIBE_MODEL=
CLIPPER_RESEARCH_MODEL=
CLIPPER_CAPTION_MODEL=
# Audio is split into chunks of this length before transcription to stay under the
# Whisper upload size limit. Lower it if you still hit "Request Entity Too Large".
CLIPPER_TRANSCRIBE_CHUNK_SEC=600

# ---- Clip detection / scoring ----
# Final score = transcript_weight * what_was_said + loudness_weight * loudness.
# Content dominates on purpose: loudness only breaks ties between windows the rater
# already liked, so a quiet, deadpan, completely unhinged take can still win.
CLIPPER_SCORE_TRANSCRIPT_WEIGHT=0.8
CLIPPER_SCORE_LOUDNESS_WEIGHT=0.2
# Minimum combined score (0–100) for a window to become a clip candidate.
CLIPPER_MIN_SCORE=55
# Max candidates returned per source.
CLIPPER_MAX_CANDIDATES=10
# Minimum words/second a window must contain to be a clip candidate. This filters out
# applause/music/cheering (loud but no speech). Raise it to demand denser talking.
CLIPPER_MIN_WORDS_PER_SEC=0.8
# How many windows get LLM-rated per source. Anything above this cap is trimmed by the
# free lexical prescreen (on text, never on loudness). Raise for better recall on long
# VODs, lower to cut spend.
CLIPPER_LLM_SCORE_BUDGET=400
# Snippets per rating request. Batching is what makes rating a whole VOD affordable;
# too high and smaller models start dropping entries from the reply.
CLIPPER_LLM_SCORE_BATCH=12
# Minimum seconds between the starts of two rated windows. Without this we pay to rate
# dozens of near-identical overlapping snippets.
CLIPPER_SCORE_STRIDE_SEC=15
# Per-streamer prescreen tuning, comma-separated, appended to the built-in lists.
# SPICE = words worth catching (inside jokes, recurring bits, names).
# FILLER = words that mark stream admin you never want clipped.
CLIPPER_SPICE_WORDS=
CLIPPER_FILLER_WORDS=
# Drop clips the rater flags as an outright account-ban risk (slurs, threats at a real
# person). Off by default — the flag is reported either way, so this only matters once
# you publish somewhere with rules.
CLIPPER_DROP_UNPOSTABLE=false

# ---- Clip skill axes ----
# The rater scores every snippet on four axes: is it FUNNY, does the opening HOOK, how
# out of POCKET is it, and is it COHERENT as a standalone clip. The criteria live at
#   <dataDir>/prompts/clip-skill.v1.md      (see: clipper prompts)
# Edit that file to change what counts as funny — it is read on every run, no rebuild.
#
# Each axis has a WEIGHT (its share of the content score) and a FLOOR. The floor is the
# important one: below it the clip is rejected outright, so a hilarious clip that opens on
# setup, a shocking one that isn't funny, or a fragment that needs missing context, gets cut.
CLIPPER_AXIS_HOOK_WEIGHT=0.3
CLIPPER_AXIS_FUNNY_WEIGHT=0.3
CLIPPER_AXIS_POCKET_WEIGHT=0.2
CLIPPER_AXIS_COHERENCE_WEIGHT=0.2
CLIPPER_AXIS_HOOK_FLOOR=40
CLIPPER_AXIS_FUNNY_FLOOR=35
CLIPPER_AXIS_POCKET_FLOOR=30
CLIPPER_AXIS_COHERENCE_FLOOR=60
# Seconds of the preceding line kept in front of the hook when the clip start is re-cut.
# Cutting exactly on the hook drops the viewer in cold; a beat of lead-in gives it context.
# 0 = hard cut straight onto the hook line.
CLIPPER_HOOK_LEAD_IN_SEC=1.5

# ---- Clip length ----
# Clips are snapped to complete sentences, aiming for TARGET within [MIN, MAX] seconds.
CLIPPER_CLIP_MIN_SEC=15
CLIPPER_CLIP_MAX_SEC=60
CLIPPER_CLIP_TARGET_SEC=30

# ---- Ingest ----
# Preferred max video height when downloading source VODs.
CLIPPER_CLIP_MAX_HEIGHT=1080

# ---- Render ----
# Explicit TrueType font for burned captions. Leave empty to use a per-OS default
# (Windows: Arial, macOS: Arial, Linux: DejaVu Sans). Set this if captions fail to
# render or you want a specific font. Example (Linux): /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
CLIPPER_CAPTION_FONT=
# Synced subtitles, generated from Whisper word timestamps and burned with ffmpeg/libass.
# Defaults mimic the bold short-form/Opus-style look: uppercase, thick dark outline,
# white text with a yellow highlighted word, centred low in the frame.
CLIPPER_SUBTITLES=true
CLIPPER_SUBTITLE_FONT_FAMILY=Arial
CLIPPER_SUBTITLE_FONT_SIZE=74
CLIPPER_SUBTITLE_PRIMARY_COLOR=#FFFFFF
CLIPPER_SUBTITLE_ACCENT_COLOR=#FFE600
CLIPPER_SUBTITLE_OUTLINE_COLOR=#080808
CLIPPER_SUBTITLE_SHADOW_COLOR=#080808
CLIPPER_SUBTITLE_OUTLINE_PX=7
CLIPPER_SUBTITLE_SHADOW_PX=2
CLIPPER_SUBTITLE_MARGIN_V=610
CLIPPER_SUBTITLE_MAX_WORDS=3
CLIPPER_SUBTITLE_MIN_DURATION_SEC=0.45
# Reframing layout:
#   fill  = scale/crop to 9:16, best for normal landscape streams
#   fit   = preserve the full frame over a blurred 9:16 background, best for vertical/3:4 clips
#   stack = crop source panels and stack them, best for two-person screen recordings
#   auto  = use Groq's transcript layout hint: stack Omegle clips, fill normal clips
#   speaker = experimental motion pan; not recommended as a default
CLIPPER_LAYOUT=fill
# Horizontal focus of the 9:16 crop: center | left | right | a 0..1 fraction.
# Only used by CLIPPER_LAYOUT=fill.
CLIPPER_CROP_X=center
# Source panels for stack/auto/speaker layouts, semicolon-separated "x,y,w,h" rects.
# Krimoe/Omegle 1280x720 preset: 34,74,600,448;634,74,600,448
CLIPPER_PANELS=

# ---- Channel monitor (auto-enqueue new VODs) ----
# Comma-separated channel/playlist URLs to poll. Leave empty to disable.
CLIPPER_MONITOR_CHANNELS=
# Seconds between polls.
CLIPPER_MONITOR_INTERVAL_SEC=900

# ---- Publishing: TikTok (Content Posting API) ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ---- Publishing: Instagram (Graph API) ----
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ---- Publishing: YouTube (Data API) ----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---- Binaries (optional — resolved from PATH if unset) ----
CLIPPER_FFMPEG_PATH=
CLIPPER_YT_DLP_PATH=

# ---- Runtime ----
# Override the OS-default data directory (downloads, work queue, clips, logs)
CLIPPER_DATA_DIR=
# Logging: trace | debug | info | warn | error
LOG_LEVEL=info
# pretty (dev) | json (prod)
LOG_FORMAT=pretty
