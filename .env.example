# ---- LLM / Transcription ----
# Groq — powers Whisper transcription AND the small-model clip research + caption writing.
# This is the only key the current pipeline needs.
GROQ_API_KEY=

# Anthropic — reserved for future modules; not required by the current pipeline.
ANTHROPIC_API_KEY=

# Model overrides (optional; sensible defaults applied in config).
# Research + caption run on a tiny, cheap Groq model — swap for any small Groq model
# (e.g. a Mistral-family or gemma model) to trade cost vs quality.
CLIPPER_WHISPER_MODEL=whisper-large-v3-turbo
CLIPPER_RESEARCH_MODEL=llama-3.1-8b-instant
CLIPPER_CAPTION_MODEL=llama-3.1-8b-instant

# ---- Clip detection / scoring ----
# Final virality score = loudness_weight * loudness + transcript_weight * transcript.
CLIPPER_SCORE_LOUDNESS_WEIGHT=0.5
CLIPPER_SCORE_TRANSCRIPT_WEIGHT=0.5
# Minimum combined score (0–100) for a window to become a clip candidate.
CLIPPER_MIN_SCORE=55
# Max candidates returned per source.
CLIPPER_MAX_CANDIDATES=10

# ---- Ingest ----
# Preferred max video height when downloading source VODs.
CLIPPER_CLIP_MAX_HEIGHT=1080

# ---- Channel monitor (auto-enqueue new VODs) ----
# Comma-separated channel/playlist URLs to poll. Leave empty to disable.
CLIPPER_MONITOR_CHANNELS=
# Seconds between polls.
CLIPPER_MONITOR_INTERVAL_SEC=900

# ---- Publishing: TikTok (Content Posting API) ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ---- Publishing: Instagram (Graph API) ----
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ---- Publishing: YouTube (Data API) ----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---- Binaries (optional — resolved from PATH if unset) ----
CLIPPER_FFMPEG_PATH=
CLIPPER_YT_DLP_PATH=

# ---- Runtime ----
# Override the OS-default data directory (downloads, work queue, clips, logs)
CLIPPER_DATA_DIR=
# Logging: trace | debug | info | warn | error
LOG_LEVEL=info
# pretty (dev) | json (prod)
LOG_FORMAT=pretty
